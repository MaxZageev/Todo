{
  "name": "example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "config": "node _schema/schema.js -q -s src/shared/config/app-config/model/AppConfigData.ts _templates/config.jsonc.j2 -w",
    "prepare": "husky install",
    "prestart": "npm run config -- -c development --no-force",
    "start": "webpack-cli serve --mode development",
    "build": "webpack-cli --mode production --env NO_CONFIG=1",
    "postbuild": "npm run config -- -o build",
    "serve": "serve build -p 4000",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "check-types": "tsc",
    "clean": "rm -rf build",
    "dotenv": "dotenv",
    "i18next": "i18next \"src/**/*.{ts,tsx}\"",
    "docker-build": "cross-env-shell dotenv -e .env.docker -- docker build --build-arg PUBLIC_PATH=$PUBLIC_PATH --build-arg STYLE_NONCE=$STYLE_NONCE -t example/web:latest .",
    "docker-up": "docker-compose up --build -d",
    "docker-restart": "docker-compose up -d",
    "docker-down": "docker-compose down"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
